{
  "openapi": "3.0.0",
  "info": {
    "title": "Labelit API",
    "version": "1.0",
    "description": "라벨링 대상 아이템 관리 API"
  },
  "servers": [
    {
      "url": "http://localhost:8080/labelit/1.0"
    }
  ],
  "paths": {
    "/items": {
      "get": {
        "summary": "아이템 목록 조회",
        "responses": {
          "200": {
            "description": "성공적으로 아이템 목록 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "새로운 아이템 추가",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "아이템 생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    },
    "/items/{id}": {
      "delete": {
        "summary": "특정 아이템 삭제",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "삭제 성공"
          },
          "404": {
            "description": "아이템 없음"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ItemCreateRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
