<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>

    <!-- add our i18n resource -->
    <resource type="i18n" name="i18n" location="jira-log-viewer" />

    <!-- add our web resources -->
    <web-resource key="jira-log-viewer-resources" name="jira-log-viewer Web Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>

        <resource type="download" name="jira-log-viewer.js" location="/assets/jira-log-viewer.js" />
        <resource type="download" name="jira-log-viewer.css" location="/assets/jira-log-viewer.css" />
        <resource type="download" name="images/" location="/images" />

        <context>jira-log-viewer</context>
    </web-resource>

    <!-- Web Resource -->
    <web-resource key="log-viewer-resources" name="Log Viewer Resources">
        <dependency>com.atlassian.auiplugin:aui-experimental</dependency>
        <resource type="download" name="logv-iewer.js" location="js/log-viewer.js" />
    </web-resource>

    <!-- WebWork Action -->
    <webwork1 key="log-viewer-action" name="Log Viewer Action" class="java.lang.Object">
        <actions>
            <action name="com.atsoft.jira.plugin.logviewer.action.LogViewerAction"
                alias="LogViewerAction">
                <view name="input">/templates/log-viewer.vm</view>
            </action>
        </actions>
    </webwork1>

</atlassian-plugin>